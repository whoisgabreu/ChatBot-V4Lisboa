# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
APP_NAME=whatsapp-ai-bot
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Evolution API
# ---------------------------------------------------------------------------
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-global-ou-da-instancia
EVOLUTION_INSTANCE=minha-instancia
# Se preenchido, exige este segredo no header abaixo (ou ?secret=)
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_HEADER=x-webhook-secret
EVOLUTION_DOWNLOAD_MEDIA=true
EVOLUTION_TYPING=true
EVOLUTION_MARK_READ=true

# ---------------------------------------------------------------------------
# Provedor de IA
#   openai   -> qualquer API compativel (OpenAI, Groq, OpenRouter, vLLM...)
#   opencode -> usa o servidor local `opencode serve`
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=500
AI_TIMEOUT=60

# --- opencode (quando AI_PROVIDER=opencode) --------------------------------
OPENCODE_BASE_URL=http://127.0.0.1:4097
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
OPENCODE_PROVIDER_ID=opencode-go
OPENCODE_MODEL_ID=deepseek-v4.1-flash
# Agente definido em opencode.json (websearch apenas)
OPENCODE_AGENT=whatsapp

# ---------------------------------------------------------------------------
# System prompt
# ---------------------------------------------------------------------------
PROMPTS_DIR=prompts
PROMPT_FILE=system.md
SYSTEM_EXTRA=

# ---------------------------------------------------------------------------
# Memoria
# ---------------------------------------------------------------------------
DATABASE_PATH=data/bot.sqlite3
HISTORY_LIMIT=20
HISTORY_MAX_CHARS=12000

# ---------------------------------------------------------------------------
# Comportamento
# ---------------------------------------------------------------------------
IGNORE_GROUPS=true
IGNORE_FROM_ME=true
# Lista separada por virgula. Vazio = atende todos.
ALLOWED_NUMBERS=
# Necessario para usar os comandos !reset, !prompt etc.
ADMIN_NUMBERS=5511999999999
REPLY_PREFIX=
MAX_REPLY_CHARS=3500
MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Fila / rate limit
# ---------------------------------------------------------------------------
MAX_CONCURRENT=4
RATE_LIMIT_PER_MINUTE=20
QUEUE_MAX_SIZE=1000
DEDUP_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Midia
# ---------------------------------------------------------------------------
TRANSCRIBE_ENABLED=true
# Vazio = usa AI_BASE_URL / AI_API_KEY (com AI_PROVIDER=openai)
# Com AI_PROVIDER=opencode, preencha explicitamente para habilitar audio.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
MEDIA_MAX_BYTES=15728640

# ---------------------------------------------------------------------------
# Audio Push-To-Talk (Piper TTS local)
# ---------------------------------------------------------------------------
TTS_ENABLED=false
TTS_VOICE_PATH=voiceGeneration/pt_BR-jeff-medium.onnx
# TTS_SPEAKER_ID=0
TTS_MAX_CHARS=900
TTS_LENGTH_SCALE=1.0
TTS_NOISE_SCALE=0.667
TTS_NOISE_W_SCALE=0.8
TTS_VOLUME=1.0

# false = responde em texto; true = audio por padrao (pode alternar com !audio)
AUDIO_REPLY_DEFAULT=false
# true = envia audio e texto; false = so audio quando ativado
AUDIO_SEND_TEXT=false

EVOLUTION_AUDIO_DELAY=1200
EVOLUTION_AUDIO_ENCODING=true
